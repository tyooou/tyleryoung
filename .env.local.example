# Copy to .env.local (gitignored). VITE_SANITY_PROJECT_ID/DATASET already
# live in the tracked .env (not secret, same as VITE_APE_KEY there) — this
# file is only for the one secret below.

# Needed only to run `npm run seed:sanity` (one-time data migration).
# Create a write-scoped API token in your Sanity project's dashboard:
# manage.sanity.io -> project 5p7ll6fp -> API -> Tokens -> Add API token
# (Editor permission). Keep it secret, never commit it.
SANITY_WRITE_TOKEN=
